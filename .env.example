# Copy to .env and fill in. .env is in .gitignore — it must never be committed.

# From @BotFather
TELEGRAM_TOKEN=

# Any long random string (16+ characters). Telegram sends it back on every webhook call.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Neon connection string, pooling ON.
# On your PC use the `test` branch. On Cloud Run use the `production` branch.
DATABASE_URL=

# Your own Telegram user ID. Leave 0 at first: send /start and the bot tells you your ID.
ADMIN_TELEGRAM_ID=0

LOG_LEVEL=INFO

# From Google AI Studio (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional second model, used only when the main one stays overloaded or slow.
GEMINI_FALLBACK_MODEL=

# PIN typed after "settle". Empty = settling is switched off.
SETTLE_PIN=

# The owners' timezone — decides "today" for expense dates.
TIMEZONE=Asia/Kolkata

# ── Email (reports, settle snapshot, meeting invites). Leave empty to switch email off. ──
# Brevo: smtp-relay.brevo.com, port 587, user = the Brevo SMTP login, password = SMTP key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
RECIPIENT_EMAILS=

# ── Scheduled jobs: Cloud Scheduler calls POST /jobs/daily with header X-Jobs-Secret. ──
JOBS_SECRET=
# Chat for scheduled messages (follow-ups, report PDFs when email is off). 0 = the admin.
NOTIFY_CHAT_ID=0
